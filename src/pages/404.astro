---
import IndexLayout from "layouts/IndexLayout.astro";
---

<IndexLayout
  title="Page not found | Anandu Babu"
  description="This page doesn't exist or has moved."
  noindex
>
  <div class="h-2 brand-gradient" aria-hidden="true"></div>
  <main
    id="main-content"
    tabindex="-1"
    class="flex flex-col items-center justify-center min-h-[calc(100vh-0.5rem)] px-4 py-16 text-center"
  >
    <p
      class="text-8xl font-black leading-none md:text-9xl gradient-text decorated-text motion-safe:animate-pulse"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="mt-6 text-2xl font-bold md:text-3xl">
      This page doesn't exist, or it has moved.
    </h1>
    <p class="mt-4 text-sm font-code text-muted">
      Code explorer mode: <span class="font-bold text-accent">activated</span>
    </p>
    <p class="mt-2 text-muted">Let's get you back on track.</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a class="btn-primary" href="/">Back to home</a>
      <a class="btn-secondary" href="/resume">View resume</a>
    </div>
  </main>
</IndexLayout>
