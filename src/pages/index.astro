---
import Footer from "components/Footer.astro";
import Projects from "components/Projects.astro";
import PromoCard from "components/ui/PromoCard.astro";
import WorkCard from "components/ui/WorkCard.astro";
import Skills from "components/Skills.astro";
import SocialLinks from "components/SocialLinks.astro";
import SiteNav from "components/SiteNav.astro";
import Icon from "components/ui/Icon.astro";
import IndexLayout from "layouts/IndexLayout.astro";
---

<IndexLayout>
  <SiteNav />

  <header
    id="home"
    class="relative flex flex-col items-center justify-center min-h-[85vh] px-4 pt-24 pb-16 bg-animated text-hero-ink"
  >
    <div class="absolute inset-0 bg-imaged" aria-hidden="true"></div>

    <div
      data-tilt
      class="tilt-card relative z-10 flex flex-col items-center w-full max-w-3xl gap-5 p-6 border shadow-xl
      border-white/50 md:flex-row md:gap-8 md:p-8 rounded-card backdrop-blur-md bg-white/20"
    >
      <img
        src="./assets/profile.png"
        width="150"
        height="150"
        class="w-28 h-28 md:w-[150px] md:h-[150px] border-4 border-white shadow-lg rounded-full object-cover"
        alt="Portrait of Anandu Babu"
      />
      <div
        class="flex flex-col items-center text-center md:items-start md:text-left md:pl-8 md:border-l-2 border-white/60"
      >
        <p
          class="inline-flex items-center gap-2 px-3 py-1 mb-3 text-xs font-semibold rounded-full bg-white/70 text-ink"
        >
          <span class="status-dot" aria-hidden="true"></span>
          Open to new opportunities
        </p>
        <h1 class="text-4xl font-black tracking-tight md:text-6xl">
          Anandu Babu
        </h1>
        <p class="mt-1 text-lg font-bold md:text-xl">Lead Frontend Engineer</p>
        <code class="mt-1 text-sm">React ● Next.js ● TypeScript</code>
        <p class="max-w-sm my-4 text-sm">
          5+ years building web apps for global banks and growing businesses.
        </p>
        <div class="flex flex-wrap justify-center gap-2 md:justify-start">
          <a class="shadow-md btn-primary" href="/resume">
            <Icon name="file-text" class="w-4 h-4" />View resume
          </a>
          <a class="btn-secondary bg-white/40 hover:bg-white/70" href="#contact">
            <Icon name="send" class="w-4 h-4" />Start a project
          </a>
        </div>
      </div>
    </div>

    <a
      href="#intro"
      class="absolute z-10 flex flex-col items-center gap-1 text-xs font-semibold -translate-x-1/2 bottom-6 left-1/2"
    >
      Scroll
      <Icon name="chevron-down" class="w-5 h-5 motion-safe:animate-bounce" />
    </a>
  </header>

  <main id="main-content" tabindex="-1">
    <section id="intro" class="px-4 py-16 text-center">
      <h2 class="max-w-2xl mx-auto text-2xl fade-in md:text-4xl">
        I build <span class="font-bold decorated-text gradient-text"
          >fast, scalable frontends</span
        ><br />
        for product teams and businesses
      </h2>

      <div class="mx-auto mt-6 space-y-3 max-w-prose text-muted">
        <p class="fade-in">
          I'm a Lead Engineer with 5+ years of experience designing and shipping
          React and Next.js applications, from multilingual banking platforms
          used by clients around the world to custom tools that run day-to-day
          operations for small businesses.
        </p>
        <p class="fade-in">
          I care about clean architecture, thoughtful UX, and helping teams ship
          with confidence through component libraries, testing, and mentoring.
        </p>
      </div>
    </section>

    <Projects />

    <section
      id="services"
      aria-labelledby="help-heading"
      class="px-4 py-12 md:px-16"
    >
      <p class="eyebrow">Services</p>
      <h2 id="help-heading" class="section-title gradient-text">
        How I can help
      </h2>
      <div id="promo" class="max-w-6xl mx-auto">
        <PromoCard
          icon="users"
          title="Frontend leadership for your team"
          description="Architecture that scales: monorepos, shared component libraries in Storybook, Jest/RTL and Cypress testing, secure auth flows, and mentoring that gets new developers productive quickly."
        />
        <PromoCard
          icon="dashboard"
          title="Custom apps for your business"
          description="Admin panels, dashboards, delivery and customer apps, and touch-friendly desktop apps for POS machines, built around how your business actually works."
        />
        <PromoCard
          icon="pen-tool"
          title="From design to production"
          description="Figma designs turned into polished, responsive interfaces with design systems, dark mode, and multilingual support, ready for real users from day one."
        />
      </div>
    </section>

    <Skills />

    <section
      id="experience"
      aria-labelledby="experience-heading"
      class="px-4 py-12 md:px-16"
    >
      <p class="eyebrow">Experience</p>
      <h2 id="experience-heading" class="section-title gradient-text">
        Where I've worked
      </h2>
      <ol class="relative max-w-3xl mx-auto ml-2 border-l-2 sm:mx-auto border-accent/25">
        <WorkCard
          company="Algosium Softwares"
          role="Lead Engineer"
          period="Nov 2025 – Present"
          current
          summary="Building immersive Three.js interfaces in Next.js with SSR and SEO-friendly metadata, running sprint planning, and scoping live monitoring dashboards."
        />
        <WorkCard
          company="ECS fin"
          link="https://www.ecsfin.com/"
          image="/assets/work/ecs.png"
          role="Senior Frontend Engineer"
          period="Aug 2022 – Nov 2025"
          summary="Built multilingual enterprise apps for global banks, an in-house Storybook component library and NX monorepo, Jest/Cypress testing, and a live coding hiring platform."
        />
        <WorkCard
          company="Tata Consultancy Services"
          link="https://www.tcs.com/"
          image="/assets/work/tcs.jpg"
          role="Junior Frontend Engineer"
          period="Sep 2020 – Jul 2022"
          summary="Migrated legacy Angular apps to React and wrote generative JavaScript (p5.js) for a digital handloom project."
        />
        <WorkCard
          company="Freelance"
          image="/assets/work/ultera.jpg"
          role="Frontend Engineer"
          period="Independent projects"
          summary="Business management suites, touch-friendly Electron POS apps, and admin panels for small businesses."
        />
      </ol>
    </section>

    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="flex flex-col px-4 py-16 text-center bg-surface/60"
    >
      <h2 id="contact-heading" class="eyebrow">Let's work together</h2>
      <p class="max-w-2xl mx-auto text-2xl fade-in md:text-4xl">
        <span
          class="bg-gradient-to-r from-yellow-400 to-orange-600
          bg-no-repeat bg-left-bottom duration-700 ease-in-out bg-w-none hover:bg-w-full"
        >
          Hiring for your team, or need something built?
        </span>
        <br />
        <span class="font-bold decorated-text gradient-text">
          I'd love to hear what you're working on.
        </span>
      </p>

      <div class="grid w-full max-w-2xl gap-4 mx-auto mt-10 sm:grid-cols-2">
        <div
          class="flex flex-col items-center gap-3 p-8 border fade-in lift rounded-card border-line bg-bg"
        >
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full bg-accent-soft text-accent"
          >
            <Icon name="briefcase" class="w-6 h-6" />
          </span>
          <h3 class="font-bold">Recruiters & hiring managers</h3>
          <a class="btn-primary" href="/resume">
            <Icon name="file-text" class="w-4 h-4" />View my resume
          </a>
        </div>
        <div
          class="flex flex-col items-center gap-3 p-8 border fade-in lift rounded-card border-line bg-bg"
        >
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full bg-accent-soft text-accent"
          >
            <Icon name="dashboard" class="w-6 h-6" />
          </span>
          <h3 class="font-bold">Clients with a project</h3>
          <a
            class="btn-primary"
            href="mailto:anandubabu.kr@gmail.com?subject=Project%20enquiry"
          >
            <Icon name="mail" class="w-4 h-4" />Email me
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <SocialLinks />

  <a
    href="#home"
    data-back-to-top
    aria-label="Back to top"
    class="fixed z-30 flex items-center justify-center w-11 h-11 rounded-full shadow-lg back-to-top bottom-5 right-5 bg-accent text-on-accent hover:bg-accent/90"
  >
    <Icon name="arrow-up" class="w-5 h-5" />
  </a>
</IndexLayout>
