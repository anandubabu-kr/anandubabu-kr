---
import Footer from "components/Footer.astro";
import Projects from "components/Projects.astro";
import PromoCard from "components/ui/PromoCard.astro";
import WorkCard from "components/ui/WorkCard.astro";
import Skills from "components/Skills.astro";
import SocialLinks from "components/SocialLinks.astro";
import IndexLayout from "layouts/IndexLayout.astro";
---

<IndexLayout>
  <header id="home" class="h-[75vh] v-full
  box-border bg-animated relative">
    <div class="flex items-center justify-center bg-imaged bg-opacity-10">
      <div
        class="flex flex-col items-center justify-center p-4 border mx-4
        border-gray-100 md:flex-row rounded-xl bg-clip-padding backdrop-filter
        backdrop-blur-sm bg-opacity-10"
      >
        <img
          src="./assets/profile.png"
          width="150px"
          class="m-3 border border-orange-400 rounded-full border-3"
          alt="Portrait of Anandu Babu"
        />
        <div class="flex flex-col h-full px-4 border-l-4 border-orange-200">
          <h1 class="text-3xl font-bold md:text-6xl">Anandu Babu</h1>
          <p class="text-xl font-bold">Lead Frontend Engineer</p>
          <code class="text-sm">React ● Next.js ● TypeScript</code>
          <p class="my-3 text-sm">
            5+ years building web apps for global banks and growing businesses.
          </p>
          <div class="flex gap-2">
            <a
              class="px-4 py-2 text-sm text-center text-white bg-orange-500
              rounded-md md:block animate-wiggle"
              href="/resume">View resume</a
            >
            <a
              class="px-4 py-2 text-sm text-center border border-orange-500
              rounded-md md:block"
              href="#contact">Start a project</a
            >
          </div>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section id="intro" class="flex flex-col my-4 text-center">
      <h2 class="text-xl mt-6 md:text-3xl w-[50%] mx-auto">
        I build <span class="font-bold decorated-text gradient-text">fast, scalable frontends</span><br />
        for product teams and businesses
      </h2>

      <br />
      <p class="mx-auto w-[60%]">
        I'm a Lead Engineer with 5+ years of experience designing and shipping
        React and Next.js applications, from multilingual banking platforms
        used by clients around the world to custom tools that run day-to-day
        operations for small businesses.
      </p>
      <p class="mx-auto w-[60%] mt-3">
        I care about clean architecture, thoughtful UX, and helping teams ship
        with confidence through component libraries, testing, and mentoring.
      </p>

      <hr class="w-[30%] mx-auto h-1 my-4 bg-orange-300 rounded-full" />
    </section>

    <Projects />

    <hr class="w-[40%] mx-auto h-1 my-4 bg-orange-300 rounded-full" />

    <h1 class="text-2xl font-black text-center gradient-text md:mt-16">
      How I can help
    </h1>
    <section
      id="promo"
      class="flex mx-4 my-4 md:py-16 text-center lg:h-[60vh] md:mx-16"
    >
      <PromoCard
        title="Frontend leadership for your team"
        description="Architecture that scales: monorepos, shared component libraries in Storybook, Jest/RTL and Cypress testing, secure auth flows, and mentoring that gets new developers productive quickly."
      />
      <PromoCard
        title="Custom apps for your business"
        description="Admin panels, dashboards, delivery and customer apps, and touch-friendly desktop apps for POS machines, built around how your business actually works."
      />
      <PromoCard
        title="From design to production"
        description="Figma designs turned into polished, responsive interfaces with design systems, dark mode, and multilingual support, ready for real users from day one."
      />
    </section>

    <Skills />

    <section id="experience" class="">
      <h1 class="mb-4 text-2xl font-black text-center gradient-text">
        Where I've worked
      </h1>
      <hr class="mx-auto mt-4 border-orange-200" />
      <div class="flex mx-4 my-4 text-center md:mx-16 promo">
        <WorkCard
          title="Algosium"
          description="Lead Engineer · Nov 2025 – Present"
        />
        <WorkCard
          title="ECS fin"
          link="https://www.ecsfin.com/"
          image="/assets/work/ecs.png"
          description="Senior Frontend Engineer · Aug 2022 – Nov 2025"
        />
        <WorkCard
          link="https://www.tcs.com/"
          title="TCS"
          image="/assets/work/tcs.jpg"
          description="Junior Frontend Engineer · Sep 2020 – Jul 2022"
        />
        <WorkCard
          title="Freelance"
          image="/assets/work/ultera.jpg"
          description="Web & desktop apps for businesses"
        />
      </div>
    </section>

    <section id="contact" class="flex flex-col my-4 text-center">
      <hr class="w-[40%] mx-auto h-1 my-4 bg-orange-300 rounded-full" />
      <p class="my-6">Let's work together</p>
      <p class="text-xl md:text-3xl w-[50%] mx-auto">
        <span
          class="bg-gradient-to-r from-yellow-400 to-orange-600
          bg-no-repeat bg-left-bottom duration-700 ease-in-out bg-w-none hover:bg-w-full"
        >
          Hiring for your team, or need something built?
        </span>
        <br />
        <span class="font-bold decorated-text gradient-text">
          I'd love to hear what you're working on.
        </span>
      </p>

      <div class="flex flex-col md:flex-row gap-6 justify-center mt-6 mx-auto">
        <div>
          <p class="font-bold">Recruiters & hiring managers</p>
          <a
            class="px-4 m-2 py-2 text-sm text-center w-fit mx-auto text-white bg-orange-500 rounded-md block"
            href="/resume"
            >View my resume &rightarrow;
          </a>
          <a
            class="text-sm underline"
            href="https://www.linkedin.com/in/anandubabukr"
            target="_blank"
            rel="noopener noreferrer">Connect on LinkedIn</a
          >
        </div>
        <div>
          <p class="font-bold">Clients with a project</p>
          <a
            class="px-4 m-2 py-2 text-sm text-center w-fit mx-auto text-white bg-orange-500 rounded-md block"
            href="mailto:anandubabu.kr@gmail.com?subject=Project%20enquiry"
            >Email me &rightarrow;
          </a>
          <a
            class="text-sm underline"
            href="https://wa.me/919947975674"
            target="_blank"
            rel="noopener noreferrer">Message on WhatsApp</a
          >
        </div>
      </div>
      <hr class="w-[20%] mx-auto h-1 my-4 bg-orange-300 rounded-full" />
    </section>
  </main>
  <Footer />
  <SocialLinks />
</IndexLayout>
