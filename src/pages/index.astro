---
import Footer from "components/Footer.astro";
import Projects from "components/Projects.astro";
import PromoCard from "components/ui/PromoCard.astro";
import WorkCard from "components/ui/WorkCard.astro";
import Skills from "components/Skills.astro";
import SocialLinks from "components/SocialLinks.astro";
import Icon from "components/ui/Icon.astro";
import IndexLayout from "layouts/IndexLayout.astro";
---

<IndexLayout>
  <header
    id="home"
    class="relative flex items-center justify-center min-h-[75vh] py-12 px-4 bg-animated text-hero-ink"
  >
    <div class="bg-imaged absolute inset-0" aria-hidden="true"></div>
    <div
      class="relative z-10 flex flex-col items-center w-full max-w-3xl gap-4 p-4 border
      border-white/40 md:flex-row md:gap-6 md:p-6 rounded-card backdrop-blur-sm bg-white/10"
    >
      <img
        src="./assets/profile.png"
        width="150"
        height="150"
        class="w-28 h-28 md:w-[150px] md:h-[150px] border-4 border-accent rounded-full object-cover"
        alt="Portrait of Anandu Babu"
      />
      <div
        class="flex flex-col items-center text-center md:items-start md:text-left md:pl-6 md:border-l-4 border-accent/40"
      >
        <h1 class="text-4xl font-black md:text-6xl">Anandu Babu</h1>
        <p class="mt-1 text-lg font-bold md:text-xl">Lead Frontend Engineer</p>
        <code class="text-sm">React ● Next.js ● TypeScript</code>
        <p class="my-3 text-sm max-w-sm">
          5+ years building web apps for global banks and growing businesses.
        </p>
        <div class="flex flex-wrap justify-center gap-2 md:justify-start">
          <a class="btn-primary" href="/resume">
            <Icon name="file-text" class="w-4 h-4" />View resume
          </a>
          <a class="btn-secondary" href="#contact">
            <Icon name="send" class="w-4 h-4" />Start a project
          </a>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section id="intro" class="px-4 my-10 text-center">
      <h2 class="mx-auto max-w-2xl text-2xl md:text-3xl">
        I build <span class="font-bold decorated-text gradient-text"
          >fast, scalable frontends</span
        ><br />
        for product teams and businesses
      </h2>

      <div class="mx-auto mt-6 space-y-3 max-w-prose text-muted">
        <p>
          I'm a Lead Engineer with 5+ years of experience designing and shipping
          React and Next.js applications, from multilingual banking platforms
          used by clients around the world to custom tools that run day-to-day
          operations for small businesses.
        </p>
        <p>
          I care about clean architecture, thoughtful UX, and helping teams ship
          with confidence through component libraries, testing, and mentoring.
        </p>
      </div>

      <hr class="divider w-1/3" />
    </section>

    <Projects />

    <hr class="divider w-2/5" />

    <section aria-labelledby="help-heading" class="px-4 md:px-16 my-10">
      <h2 id="help-heading" class="section-title gradient-text">
        How I can help
      </h2>
      <div id="promo" class="flex my-4 text-center md:py-10">
        <PromoCard
          icon="users"
          title="Frontend leadership for your team"
          description="Architecture that scales: monorepos, shared component libraries in Storybook, Jest/RTL and Cypress testing, secure auth flows, and mentoring that gets new developers productive quickly."
        />
        <PromoCard
          icon="dashboard"
          title="Custom apps for your business"
          description="Admin panels, dashboards, delivery and customer apps, and touch-friendly desktop apps for POS machines, built around how your business actually works."
        />
        <PromoCard
          icon="pen-tool"
          title="From design to production"
          description="Figma designs turned into polished, responsive interfaces with design systems, dark mode, and multilingual support, ready for real users from day one."
        />
      </div>
    </section>

    <Skills />

    <section
      id="experience"
      aria-labelledby="experience-heading"
      class="px-4 md:px-16 my-10"
    >
      <h2 id="experience-heading" class="section-title gradient-text">
        Where I've worked
      </h2>
      <hr class="border-line" />
      <div class="flex my-4 text-center promo">
        <WorkCard
          title="Algosium"
          description="Lead Engineer · Nov 2025 – Present"
        />
        <WorkCard
          title="ECS fin"
          link="https://www.ecsfin.com/"
          image="/assets/work/ecs.png"
          description="Senior Frontend Engineer · Aug 2022 – Nov 2025"
        />
        <WorkCard
          link="https://www.tcs.com/"
          title="TCS"
          image="/assets/work/tcs.jpg"
          description="Junior Frontend Engineer · Sep 2020 – Jul 2022"
        />
        <WorkCard
          title="Freelance"
          image="/assets/work/ultera.jpg"
          description="Web & desktop apps for businesses"
        />
      </div>
    </section>

    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="flex flex-col px-4 my-10 text-center"
    >
      <hr class="divider w-2/5" />
      <h2 id="contact-heading" class="my-4 text-sm font-semibold uppercase tracking-widest text-muted">
        Let's work together
      </h2>
      <p class="mx-auto max-w-2xl text-xl md:text-3xl">
        <span
          class="bg-gradient-to-r from-yellow-400 to-orange-600
          bg-no-repeat bg-left-bottom duration-700 ease-in-out bg-w-none hover:bg-w-full"
        >
          Hiring for your team, or need something built?
        </span>
        <br />
        <span class="font-bold decorated-text gradient-text">
          I'd love to hear what you're working on.
        </span>
      </p>

      <div
        class="grid w-full max-w-2xl gap-4 mx-auto mt-8 sm:grid-cols-2"
      >
        <div class="flex flex-col items-center gap-3 p-6 rounded-card bg-surface">
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full bg-accent-soft text-accent"
          >
            <Icon name="briefcase" class="w-6 h-6" />
          </span>
          <h3 class="font-bold">Recruiters & hiring managers</h3>
          <a class="btn-primary" href="/resume">
            <Icon name="file-text" class="w-4 h-4" />View my resume
          </a>
          <a
            class="inline-flex items-center gap-1.5 text-sm underline underline-offset-4"
            href="https://www.linkedin.com/in/anandubabukr"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" class="w-4 h-4" />Connect on LinkedIn
          </a>
        </div>
        <div class="flex flex-col items-center gap-3 p-6 rounded-card bg-surface">
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full bg-accent-soft text-accent"
          >
            <Icon name="dashboard" class="w-6 h-6" />
          </span>
          <h3 class="font-bold">Clients with a project</h3>
          <a
            class="btn-primary"
            href="mailto:anandubabu.kr@gmail.com?subject=Project%20enquiry"
          >
            <Icon name="mail" class="w-4 h-4" />Email me
          </a>
          <a
            class="inline-flex items-center gap-1.5 text-sm underline underline-offset-4"
            href="https://wa.me/919947975674"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" class="w-4 h-4" />Message on WhatsApp
          </a>
        </div>
      </div>
      <hr class="divider w-1/5 mt-10" />
    </section>
  </main>
  <Footer />
  <SocialLinks />
</IndexLayout>
