---
const { arr = [], alt = "" } = Astro.props;
---

<image-carousel class="block lg:w-1/2 shrink-0" data-images={JSON.stringify(arr)}>
  <img class="w-full rounded-md bg-accent-soft" alt={alt} />
</image-carousel>

<script>
  // Cycles through project screenshots. Rotation is skipped entirely when the
  // visitor prefers reduced motion, and pauses while the pointer is over it.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  class ImageCarousel extends HTMLElement {
    index = 0;
    images: string[] = [];
    intervalId: ReturnType<typeof setInterval> | null = null;
    img: HTMLImageElement | null = null;

    connectedCallback() {
      this.img = this.querySelector("img");
      try {
        this.images = JSON.parse(this.dataset.images ?? "[]");
      } catch (e) {
        console.error("Error parsing data-images attribute:", e);
      }
      if (!this.img || this.images.length === 0) return;

      this.show();
      if (this.images.length > 1) {
        this.start();
        this.addEventListener("mouseenter", this.stop);
        this.addEventListener("mouseleave", this.start);
        reduceMotion.addEventListener("change", this.start);
      }
    }

    disconnectedCallback() {
      this.stop();
      reduceMotion.removeEventListener("change", this.start);
    }

    show = () => {
      if (this.img) this.img.src = this.images[this.index];
    };

    next = () => {
      this.index = (this.index + 1) % this.images.length;
      this.show();
    };

    start = () => {
      this.stop();
      if (!reduceMotion.matches) this.intervalId = setInterval(this.next, 2000);
    };

    stop = () => {
      if (this.intervalId) clearInterval(this.intervalId);
      this.intervalId = null;
    };
  }
  customElements.define("image-carousel", ImageCarousel);
</script>
