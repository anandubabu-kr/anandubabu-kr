---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  title: string;
  icon: IconName;
}
const { title, icon } = Astro.props;
---

<li
  class="flex flex-col items-center justify-center gap-2 px-4 py-3 m-1 rounded-card sm:flex-row"
>
  <Icon name={icon} brandColor class="w-8 h-8 md:w-9 md:h-9" />
  <h3 class="text-sm md:text-base">{title}</h3>
</li>
