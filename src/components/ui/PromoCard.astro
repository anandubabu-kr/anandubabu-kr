---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  icon: IconName;
}
const { title, description, icon } = Astro.props;
---

<!-- Content is always visible; the gradient sweep is a hover flourish (global.css). -->
<article
  class="flex flex-col items-start gap-3 p-6 text-left border promo-item rounded-card border-line bg-surface fade-in"
>
  <span
    class="flex items-center justify-center w-12 h-12 rounded-full promo-icon bg-accent-soft text-accent"
  >
    <Icon name={icon} class="w-6 h-6" />
  </span>
  <h3 class="text-lg font-bold">{title}</h3>
  <p class="text-sm leading-relaxed">{description}</p>
</article>
