---
const { title, description } = Astro.props;
---

<!--
  The description is revealed on hover. tabindex="0" lets keyboard users
  reach the card, and the group-focus classes reveal it on focus too.
-->
<article
  tabindex="0"
  class="flex flex-col justify-center hover:items-start focus:items-start
   promo-item group rounded-md py-4 md:pt-6 text-center
    bg-surface fade-in"
>
  <div
    class="text-center mx-auto font-bold px-4 scale-125
     duration-300 flex justify-center flex-col z-10
      group-hover:scale-100 group-focus:scale-100"
  >
    <span class="mx-auto">
      <img
        class="w-12 md:w-8 lg:w-12 md:my-2"
        src="./assets/check.svg"
        alt=""
      />
    </span>
    <h3 class="md:font-bold">
      {title}
    </h3>
  </div>
  <p
    class="px-4 mx-auto overflow-hidden group-hover:h-auto group-focus:h-auto mt-4
     md:mt-0 z-10 md:scale-0 group-hover:scale-100 group-focus:scale-100"
  >
    {description}
  </p>
</article>
