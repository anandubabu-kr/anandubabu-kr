---
import Icon from "./Icon.astro";

interface Props {
  company: string;
  role: string;
  period: string;
  summary: string;
  link?: string;
  image?: string;
  current?: boolean;
}
const { company, role, period, summary, link, image, current = false } =
  Astro.props;
---

<!-- One entry on the experience timeline (rendered inside an <ol>). -->
<li class="relative pb-10 pl-10 timeline-item fade-in last:pb-0">
  <span
    aria-hidden="true"
    class="absolute left-0 w-4 h-4 transition-transform -translate-x-1/2 rounded-full timeline-dot top-6 bg-accent"
  ></span>

  <div
    class="flex flex-col gap-4 p-5 border sm:flex-row sm:items-start rounded-card border-line bg-bg lift transition-[transform,box-shadow] duration-300"
  >
    {
      image ? (
        <img
          src={image}
          width="64"
          height="64"
          loading="lazy"
          class="object-contain w-16 h-16 bg-white rounded-md work-logo"
          alt=""
        />
      ) : (
        <span class="flex items-center justify-center w-16 h-16 rounded-md shrink-0 text-accent bg-accent-soft">
          <Icon name="building" class="w-8 h-8" />
        </span>
      )
    }

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h3 class="text-lg font-bold">
          {
            link ? (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 hover:text-accent"
              >
                {company}
                <Icon name="external-link" class="w-4 h-4 text-muted" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ) : (
              company
            )
          }
        </h3>
        {
          current && (
            <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-accent-soft text-accent">
              Current
            </span>
          )
        }
      </div>
      <p class="font-semibold">{role}</p>
      <p class="flex items-center gap-1.5 mt-1 text-sm text-muted">
        <Icon name="calendar" class="w-4 h-4" />{period}
      </p>
      <p class="mt-3 text-sm leading-relaxed">{summary}</p>
    </div>
  </div>
</li>
