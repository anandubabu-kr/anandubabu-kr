---
import ImageCarousel from "./ImageCarousel.astro";
import Icon from "./Icon.astro";

const { title, description, image, tools, date } = Astro.props;
---

<article
  class="w-full md:w-[80%] mx-auto box-border flex mt-8 gap-4 bg-surface
   flex-col lg:flex-row overflow-hidden card my-4 rounded-card p-3 fade-in"
>
  <ImageCarousel arr={image} alt={`${title} screenshot`} />

  <div
    class="box-border px-2 py-2 text-ink lg:w-1/2
      md:rounded-xl"
  >
    <h3 class="text-xl font-bold">
      {title}
    </h3>
    <p class="flex items-center gap-1.5 mt-1 text-sm text-muted">
      <Icon name="calendar" class="w-4 h-4" />
      <span class="sr-only">Date:</span>{date}
    </p>
    <p class="mt-3">{description}</p>
    <p class="flex items-center gap-1.5 mt-3 text-xs font-code text-muted">
      <Icon name="wrench" class="w-4 h-4" />
      <span class="sr-only">Built with:</span>{tools}
    </p>
  </div>
</article>
