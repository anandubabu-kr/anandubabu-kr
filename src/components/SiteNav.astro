---
import Icon from "./ui/Icon.astro";

interface Props {
  /** Which page we're on. Section links are in-page on home, "/#..." elsewhere. */
  current?: "home" | "blog";
}
const { current = "home" } = Astro.props;
const onHome = current === "home";

const sections = [
  { id: "projects", label: "Work" },
  { id: "services", label: "Services" },
  { id: "skills", label: "Skills" },
  { id: "experience", label: "Experience" },
  { id: "contact", label: "Contact" },
];

// `spy` links get the scroll-position highlight (home only).
const links = [
  ...sections.map((s) => ({
    href: onHome ? `#${s.id}` : `/#${s.id}`,
    label: s.label,
    spy: onHome,
    page: false,
  })),
  { href: "/learning", label: "Blog", spy: false, page: current === "blog" },
];
---

<!--
  Fixed top bar. Transparent over the hero; index.js sets data-scrolled to
  frost it, drives the progress bar, highlights the current section, and
  toggles the mobile menu.
-->
<div data-site-nav data-scrolled="false" class="site-nav fixed inset-x-0 top-0 z-40">
  <div class="flex items-center justify-between h-16 max-w-6xl px-4 mx-auto">
    <a href={onHome ? "#home" : "/"} class="text-lg font-black tracking-tight">
      Anandu<span class="text-accent">.</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav-link"
                data-nav-link={l.spy ? "" : undefined}
                aria-current={l.page ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/resume" class="btn-primary !py-1.5 hidden sm:inline-flex">
        <Icon name="file-text" class="w-4 h-4" />Resume
      </a>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="flex items-center justify-center w-10 h-10 rounded-md lg:hidden hover:bg-accent-soft"
      >
        <span class="icon-open"><Icon name="menu" class="w-6 h-6" /></span>
        <span class="icon-close"><Icon name="close" class="w-6 h-6" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary" hidden class="lg:hidden border-t border-line">
    <ul class="flex flex-col max-w-6xl px-4 py-2 mx-auto">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block nav-link"
              data-nav-link={l.spy ? "" : undefined}
              aria-current={l.page ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="py-2 sm:hidden">
        <a href="/resume" class="w-full btn-primary">
          <Icon name="file-text" class="w-4 h-4" />View resume
        </a>
      </li>
    </ul>
  </nav>

  <div
    data-progress
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-0.5 brand-gradient scroll-progress"
  >
  </div>
</div>
