---
import Icon from "./ui/Icon.astro";

const links = [
  { href: "#projects", label: "Work" },
  { href: "#services", label: "Services" },
  { href: "#skills", label: "Skills" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<!--
  Fixed top bar. Transparent over the hero; index.js sets data-scrolled to
  frost it, drives the progress bar, highlights the current section, and
  toggles the mobile menu.
-->
<div data-site-nav data-scrolled="false" class="site-nav fixed inset-x-0 top-0 z-40">
  <div class="flex items-center justify-between h-16 max-w-6xl px-4 mx-auto">
    <a href="#home" class="text-lg font-black tracking-tight">
      Anandu<span class="text-accent">.</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link" data-nav-link>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/resume" class="btn-primary !py-1.5 hidden sm:inline-flex">
        <Icon name="file-text" class="w-4 h-4" />Resume
      </a>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="flex items-center justify-center w-10 h-10 rounded-md md:hidden hover:bg-accent-soft"
      >
        <span class="icon-open"><Icon name="menu" class="w-6 h-6" /></span>
        <span class="icon-close"><Icon name="close" class="w-6 h-6" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary" hidden class="md:hidden border-t border-line">
    <ul class="flex flex-col max-w-6xl px-4 py-2 mx-auto">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block nav-link" data-nav-link>
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="py-2 sm:hidden">
        <a href="/resume" class="w-full btn-primary">
          <Icon name="file-text" class="w-4 h-4" />View resume
        </a>
      </li>
    </ul>
  </nav>

  <div
    data-progress
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-0.5 brand-gradient scroll-progress"
  >
  </div>
</div>
