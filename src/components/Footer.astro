---
import Icon, { type IconName } from "./ui/Icon.astro";

const social: { label: string; href: string; icon: IconName }[] = [
  { label: "GitHub", href: "https://github.com/anandubabu-kr/", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/anandubabukr", icon: "linkedin" },
  { label: "CodePen", href: "https://codepen.io/anandubabucj7", icon: "codepen" },
  { label: "Instagram", href: "https://www.instagram.com/anandubabukr", icon: "instagram" },
];

const contact: { label: string; text: string; href: string; icon: IconName }[] = [
  { label: "Phone", text: "+91 9947975674", href: "tel:+919947975674", icon: "phone" },
  { label: "Email", text: "anandubabu.kr@gmail.com", href: "mailto:anandubabu.kr@gmail.com", icon: "mail" },
  { label: "WhatsApp", text: "WhatsApp", href: "https://wa.me/919947975674", icon: "whatsapp" },
];
---

<footer class="px-4 py-10 mt-4 bg-inverse text-on-inverse">
  <div>
    <div class="w-16 mx-auto" aria-hidden="true">
      <svg
        width="100%"
        height="100%"
        viewBox="-2.4 -2.4 28.80 28.80"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        stroke="#ffffff"
      >
        <g
          id="SVGRepo_bgCarrier"
          stroke-width="0"
          transform="translate(0,0), scale(1)"
        >
          <rect
            x="-2.4"
            y="-2.4"
            width="28.80"
            height="28.80"
            rx="14.4"
            fill="#ffffee"
            strokewidth="0"
            class="svg-elem-1"></rect>
        </g>
        <g
          id="SVGRepo_tracerCarrier"
          stroke-linecap="round"
          stroke-linejoin="round"></g>
        <g id="SVGRepo_iconCarrier">
          <path
            d="M16 14C16 16.2091 14.2091 18 12 18C9.79086 18 8 16.2091 8 14V10C8 7.79086 9.79086 6 12 6C14.2091 6 16 7.79086 16 10"
            stroke="#eb5c31"
            stroke-width="1.704"
            stroke-linecap="round"
            class="svg-elem-2"></path>
          <path
            d="M8.5 10H16"
            stroke="#eb5c31"
            stroke-width="1.704"
            stroke-linecap="round"
            class="svg-elem-3"></path>
          <path
            d="M12 10V6"
            stroke="#eb5c31"
            stroke-width="1.704"
            stroke-linecap="round"
            class="svg-elem-4"></path>
          <path
            d="M12 8.89182V3.85022C12 2.73646 11.0955 1.81254 10.0128 2.03267C5.44193 2.96194 2 7.03407 2 11.9168C2 13.7706 2.49614 15.5075 3.36182 17M16.3641 2.8419C19.7003 4.4761 22 7.92565 22 11.9168C22 17.4856 17.5228 22 12 22C10.1786 22 8.47087 21.509 7 20.651"
            stroke="#eb5c31"
            stroke-width="1.704"
            stroke-linecap="round"
            class="svg-elem-5"></path>
        </g>
      </svg>
    </div>
    <p class="mt-2 text-center">&copy; {new Date().getFullYear()} Anandu Babu</p>
  </div>

  <ul class="flex justify-center gap-3 mx-auto mt-6" aria-label="Social profiles">
    {
      social.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${s.label} (opens in a new tab)`}
            title={s.label}
            class="flex items-center justify-center w-10 h-10 transition-colors rounded-full bg-on-inverse/10 hover:bg-accent hover:text-on-accent"
          >
            <Icon name={s.icon} class="w-5 h-5" />
          </a>
        </li>
      ))
    }
  </ul>

  <address
    class="flex flex-col items-center justify-center gap-3 mt-6 not-italic md:flex-row md:gap-8"
  >
    {
      contact.map((c) => (
        <a
          href={c.href}
          class="inline-flex items-center gap-2 hover:text-accent"
          {...(c.href.startsWith("http") && {
            target: "_blank",
            rel: "noopener noreferrer",
          })}
        >
          <Icon name={c.icon} class="w-5 h-5" />
          <span class="sr-only">{c.label}:</span>
          {c.text}
        </a>
      ))
    }
  </address>

  <p class="mt-8 text-sm text-center text-on-inverse/70">
    Built with Astro, Tailwind CSS &amp; GitHub
  </p>
</footer>
