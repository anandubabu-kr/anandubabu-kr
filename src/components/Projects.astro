---
import ProjectCard from "./ui/ProjectCard.astro";

const data = [
  {
    title: "Live Coding Assessment Platform",
    description:
      "An in-house hiring tool built at ECS. Candidates solve real React tasks in an embedded StackBlitz editor while interviewers review their work in one place, replacing ad-hoc take-home tests with a consistent screening process.",
    image: [
      "/assets/projects/ecs/1.png",
      "/assets/projects/ecs/2.png",
      "/assets/projects/ecs/3.png",
    ],
    tools: "ReactJS, Tailwind",
    date: "July 2025",
  },
  {
    title: "Humanato Admin",
    description:
      "The control panel behind the Humanato app. Managers track customer subscriptions and oversee day-to-day operations from a clean web dashboard with dark theme support.",
    image: ["/assets/projects/humanato/1.png"],
    tools: "ReactJS, Tailwind",
    date: "July 2025",
  },
  {
    title: "TideHub App Suite",
    description:
      "A complete business management suite: an admin panel, a delivery app, a customer-facing app, and a multi-tenant desktop app for touch-screen Windows POS machines with printer and device support.",
    image: ["/assets/projects/p-1-metro.png"],
    tools: "ReactJS, Tailwind, ElectronJS",
    date: "July 2023 – Present",
  },
  // {
  //   title: "JSON translator",
  //   description:
  //     "Empowering developers to seamlessly implement internationalization and localization on their websites.",
  //   image: "/assets/projects/p1-jsontranslator.png",
  //   tools: "ReactJS, TypeScript, Tailwind, CAT application, dev tool",
  //   date: "Nov 2023",
  // },
];
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="px-4 py-12 md:px-16"
>
  <p class="eyebrow">Portfolio</p>
  <h2 id="projects-heading" class="section-title gradient-text">
    Selected work
  </h2>
  <div class="flex flex-col w-full">
    {
      data.map((project, i) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          tools={project.tools}
          date={project.date}
          reverse={i % 2 === 1}
        />
      ))
    }
  </div>
</section>
