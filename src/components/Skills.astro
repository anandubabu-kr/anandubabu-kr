---
import SkillCard from "./ui/SkillCard.astro";
import type { IconName } from "./ui/Icon.astro";

const data: { title: string; icon: IconName }[] = [
  { title: "React", icon: "react" },
  { title: "Next.js", icon: "nextjs" },
  { title: "TypeScript", icon: "typescript" },
  { title: "Astro", icon: "astro" },
  { title: "Tailwind CSS", icon: "tailwind" },
  { title: "Figma", icon: "figma" },
  { title: "Firebase", icon: "firebase" },
  { title: "Node.js", icon: "nodejs" },
  { title: "Git / GitHub", icon: "github" },
  { title: "Ant Design", icon: "antd" },
  { title: "Express", icon: "express" },
];
---

<section
  id="skills"
  aria-labelledby="skills-heading"
  class="px-4 my-10 md:my-16 md:px-16"
>
  <h2 id="skills-heading" class="section-title gradient-text">
    Tools I work with
  </h2>
  <hr class="border-line" />
  <ul
    id="items"
    class="box-border flex flex-wrap items-center justify-center gap-2 lg:w-[70%] lg:mx-auto mt-7"
  >
    {data.map((item) => <SkillCard title={item.title} icon={item.icon} />)}
  </ul>
</section>
