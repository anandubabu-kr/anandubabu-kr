---
import "styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const site = "https://anandubabu.web.app";
const {
  title = "Anandu Babu | Lead Frontend Engineer · React & Next.js",
  description = "Lead Frontend Engineer with 5+ years building scalable React and Next.js apps for global banks and growing businesses. Open to new roles and freelance projects.",
  noindex = false,
} = Astro.props;
const image = `${site}/assets/og-image.png`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Anandu Babu",
  url: site,
  image: `${site}/assets/profile.png`,
  jobTitle: "Lead Frontend Engineer",
  worksFor: { "@type": "Organization", name: "Algosium Softwares" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Calicut" },
    { "@type": "CollegeOrUniversity", name: "Amrita Vishwa Vidyapeetham" },
  ],
  knowsAbout: [
    "React",
    "Next.js",
    "TypeScript",
    "Frontend architecture",
    "Design systems",
    "Electron",
  ],
  email: "mailto:anandubabu.kr@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/anandubabukr",
    "https://github.com/anandubabu-kr",
    "https://codepen.io/anandubabucj7",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anandu Babu" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={site + "/"} />
      )
    }
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (LinkedIn, WhatsApp, Slack, etc.) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Anandu Babu" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={site + "/"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Anandu Babu, Lead Frontend Engineer" />
    <meta property="profile:first_name" content="Anandu" />
    <meta property="profile:last_name" content="Babu" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {
      !noindex && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} />
      )
    }
    <!-- reveals .fade-in elements on scroll (they start at opacity 0) -->
    <script src="../scripts/index.js"></script>
  </head>
  <body class="box-border bg-bg text-ink font-body antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
